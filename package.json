{
  "name": "acdyon-resilient-ingestion-system",
  "version": "1.0.0",
  "description": "Industrial-grade job ingestion pipeline with stealth anti-detection, circuit breakers, self-healing parser, and real-time observability dashboard.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
